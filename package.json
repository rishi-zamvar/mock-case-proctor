{
  "name": "mock-case-proctor",
  "productName": "Mock Case Proctor",
  "version": "1.0.0",
  "description": "An Electron application with React and TypeScript",
  "main": "./out/main/index.js",
  "author": "example.com",
  "homepage": "https://electron-vite.org",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "package": "electron-vite build && electron-builder --mac --arm64",
    "test": "vitest run",
    "test:e2e": "electron-vite build && playwright test --grep-invert \"@live|@packaged|@t2|@audition\"",
    "test:packaged": "npm run package && npm run verify:package && playwright test --grep @packaged",
    "test:live": "LIVE=1 vitest run && electron-vite build && playwright test --grep @live",
    "postinstall": "install-electron && electron-builder install-app-deps",
    "verify:package": "bash scripts/verify-package.sh",
    "fetch:voice": "bash scripts/fetch-voice-assets.sh",
    "test:e2e:t2": "bash scripts/fetch-voice-assets.sh && electron-vite build && playwright test --grep @t2",
    "audition": "bash scripts/fetch-voice-assets.sh && electron-vite build && playwright test --grep @audition"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.4.0",
    "react-pdf": "11.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.1",
    "@electron-toolkit/eslint-config-ts": "^4.0.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@fontsource-variable/inter": "5.3.0",
    "@huggingface/transformers": "4.3.2",
    "@met4citizen/headtts": "1.3.0",
    "@met4citizen/talkinghead": "1.8.2",
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "5.1.0",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "jsdom": "30.1.3",
    "prettier": "^3.9.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "0.186.1",
    "typescript": "^5.9.3",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  },
  "overrides": {
    "@electron/osx-sign": {
      "isbinaryfile": "5.0.7"
    }
  }
}
